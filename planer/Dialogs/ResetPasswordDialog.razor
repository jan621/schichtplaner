@using CrossCutting.Language
@using Microsoft.Extensions.Localization
@using CrossCutting.Identity
@using System.Text.RegularExpressions

@inject IStringLocalizer<Language> Localizer;


<MudDialog>
    <DialogContent>
        <MudForm @bind-IsValid="@_valid" Class="mb-2">
            <MudText Class="mb-2" Align="Align.Center">@ContentText</MudText>
            <MudGrid>

                <!--Token-->
                <MudItem xs="12">
                    <MudTextField Label="@Localizer["Token"]" Variant="Variant.Outlined" @bind-Value="_passwordResetRequest.Token"
                                  Required="true" RequiredError="@Localizer["FieldIsRequired"]"/>
                </MudItem>
                <!---->

                <!--Password - RePeatPassword-->
                <MudItem xs="6">
                    <MudTextField Label="@Localizer["Password"]" Variant="Variant.Outlined" @bind-Value="_passwordResetRequest.Password"
                                  InputType="@_passwordInputType" Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))"
                                  Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon" OnAdornmentClick="TogglePasswordVisibility"
                                  Required="true" RequiredError="@Localizer["FieldIsRequired"]"/>
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Label="@Localizer["RePeatPassword"]" Variant="Variant.Outlined" @bind-Value="_rePeatPassword"
                                  InputType="@_passwordInputType" Validation="@(new Func<string, string>(PasswordMatch))"
                                  Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon" OnAdornmentClick="TogglePasswordVisibility"
                                  Required="true" RequiredError="@Localizer["FieldIsRequired"]"/>
                </MudItem>
                <!---->
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="@Color.Error" Variant="Variant.Outlined" OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Variant="Variant.Outlined" Disabled="!_valid" Color="Color.Success"
                   OnClick="ResetPassword">
            @Localizer["ResetPassword"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public required string ContentText { get; set; }

    private InputType _passwordInputType = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    void ResetPassword() => MudDialog.Close(DialogResult.Ok(_passwordResetRequest));
    void Cancel() => MudDialog.Cancel();

    private bool _valid, _passwordVisibility;
    private string _rePeatPassword = string.Empty;

    private PasswordResetRequest _passwordResetRequest = new()
    {
        Token = string.Empty,
        Password = string.Empty,
        UserName = string.Empty
    };

    void TogglePasswordVisibility()
    {
        if (_passwordVisibility)
        {
            _passwordVisibility = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInputType = InputType.Password;
        }
        else
        {
            _passwordVisibility = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInputType = InputType.Text;
        }
    }
    
    private IEnumerable<string> PasswordStrength(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
        {
            yield return "Password is required!";
            yield break;
        }
        
        if (password.Length < 8)
            yield return Localizer["PasswordMinLength"];
        if (!Regex.IsMatch(password, @"[A-Z]"))
            yield return Localizer["PasswordMinOneCapitalLetter"];
        if (!Regex.IsMatch(password, @"[a-z]"))
            yield return Localizer["PasswordMinOneLowerCaseLetter"];
        if (!Regex.IsMatch(password, @"[0-9]"))
            yield return Localizer["PasswordNeedOneDigit"];
        if (!Regex.IsMatch(password, @"[!@#$%^&*(),.?""'{}[\]:;<>/\\|_~`+=-]"))
            yield return Localizer["PasswordMinOneAlphanumericCharacter"];
    }

    string PasswordMatch(string password)
    {
        if (_passwordResetRequest.Password != password)
            return Localizer["PasswordDontMatch"];

        return string.Empty;
    }
}