@using CrossCutting.Language
@using Microsoft.Extensions.Localization
@using CrossCutting.Entities
@using CrossCutting.Enums
@using EmployeeManagement.Contract
@using TagManagement.Contract
@using UserManagement.Contract
@using AppointmentManagement.Contract

@inject IStringLocalizer<Language> Localizer;
@inject ITagManager TagManager;
@inject IAppointmentManager AppointmentManager;

<MudDialog>
    <DialogContent>
        <MudForm @bind-IsValid="@_valid" Class="mb-2">
            <MudGrid>
                <MudItem xs="12">
                    <div class="d-flex justify-center">
                        <MudText>@Localizer["InsertAppointmentData"]</MudText>
                    </div>
                </MudItem>

                <!--Date - Tag-->
                <MudItem sm="6" xs="12">
                    <MudDatePicker Label="@Localizer["Date"]" Variant="Variant.Outlined" @bind-Date="_appointmentDate" Required="true"
                                   RequiredError="@Localizer["FieldIsRequired"]" DisableToolbar="true"/>
                </MudItem>

                <MudItem sm="6" xs="12">
                    <MudSelect T="Tag" Label="@Localizer["Tags"]" MultiSelection="false" @bind-Value="@_selectedTag"
                               Required="true" Clearable="true" RequiredError="@Localizer["FieldIsRequired"]">
                        @foreach (var tag in _tags)
                        {
                            <MudSelectItem T="Tag" Value="@tag">@tag.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <!---->
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="@Color.Error" Variant="Variant.Outlined" OnClick="@Cancel" Class="mt-2">@Localizer["Cancel"]</MudButton>
        <MudButton Variant="Variant.Outlined" Disabled="@(!_valid || _loading)" Color="Color.Success" OnClick="@AddAppointment" Class="mt-2">
            @if (_loading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <MudText Class="ms-2">@Localizer["Processing"]</MudText>
            }
            else
            {
                <MudText>@Localizer["Add"]</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    private bool _valid, _isMobile, _loading;

    private Tag? _selectedTag;
    private IEnumerable<Tag> _tags = new List<Tag>();
    private DateTime? _appointmentDate = DateTime.Now;

    private Appointment _appointment = new Appointment
    {
        Id = string.Empty,
        Date = default,
        Tag = null
    };

    protected override async Task OnInitializedAsync()
    {
        _tags = await TagManager.GetAllNonAccommodationAsync();
        await base.OnInitializedAsync();
    }

    private async Task AddAppointment()
    {
        _loading = true;
        _appointment.Date = _appointmentDate ?? DateTime.Now;
        _appointment.Tag = _selectedTag ?? new Tag
        {
            Id = string.Empty,
            Name = string.Empty,
            ColorHexCode = string.Empty,
            IsNonAccommodation = false,
            AccommodationIds = new List<string>(),
            SortIndex = 0
        };
        await AppointmentManager.CreateAsync(_appointment);
        _loading = false;
        MudDialog.Close(true);
    }

    void Cancel() => MudDialog.Close(false);
}