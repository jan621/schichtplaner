@page "/employees"
@attribute [Authorize]

@using CrossCutting.Language
@using Microsoft.Extensions.Localization
@using CrossCutting.Entities.NotMapped
@using EmployeeManagement.Contract
@using Microsoft.AspNetCore.Identity
@using planer.Dialogs
@using planer.Dialogs.Employee
@using CrossCutting.Entities

@inject IStringLocalizer<Language> Localizer;
@inject IConfiguration Configuration;
@inject ISnackbar Snackbar;
@inject IDialogService DialogService;
@inject IEmployeeManager EmployeeManager;
@inject UserManager<User> IdentityUserManager;
@inject IJSRuntime JsRuntime;

<PageTitle>@Localizer["ViewEmployees"]</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h6">@Localizer["Employee"]</MudText>
        <MudStack Row="@(!_isMobile)" Justify="Justify.SpaceBetween" Style="width: 100%" Class="mb-4">
            <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder=@Localizer["SearchPlaceHolder"]
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium">
            </MudTextField>

            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Success"
                       Variant="Variant.Outlined" OnClick="@AddEmployee">
                @Localizer["InviteEmployee"]
            </MudButton>
        </MudStack>

        @if (_selectedEmployees.Any())
        {
            <MudStack Row="@(!_isMobile)" Style="width: 100%"
                      Justify="@(_isMobile ? Justify.Center : Justify.FlexEnd)">
                @if (_selectedEmployees.Count == 1)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.Edit" Color="Color.Warning"
                               Variant="Variant.Outlined" OnClick="@EditEmployee">
                        @Localizer["ModifyEmployee"]
                    </MudButton>
                }
                <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error"
                           Variant="Variant.Outlined" OnClick="@DeleteEmployee">
                    @Localizer["DeleteEmployee"]
                </MudButton>
            </MudStack>
        }

        <MudTable @ref="_table" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" FixedHeader="true"
                  Height="@Configuration["Settings:TableHeight"]" MultiSelection="true"
                  GroupHeaderStyle="background-color:var(--mud-palette-background-grey)"
                  @bind-SelectedItems="@_selectedEmployees"
                  GroupFooterClass="mb-4" Elevation="3"
                  ServerData="@(new Func<TableState, Task<TableData<User>>>(ServerReload))">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortLabel="employeeFullName_field" T="User">@Localizer["Name"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortLabel="userEmail_field" T="User">@Localizer["Email"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortLabel="userTeam_field" T="User">@Localizer["Teams"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortLabel="userStatus_field" T="User">@Localizer["Status"]</MudTableSortLabel>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">
                    <div style="max-height: @Configuration["Settings:TableScrollAt"]; overflow-y:scroll">
                        @context.FullName
                    </div>
                </MudTd>
                <MudTd DataLabel="Email">
                    <div style="max-height: @Configuration["Settings:TableScrollAt"]; overflow-y:scroll">
                        @context.Email
                    </div>
                </MudTd>
                <MudTd DataLabel="Teams">
                    <div style="max-height: @Configuration["Settings:TableScrollAt"]; overflow-y:scroll">
                        @if (context?.Teams?.Any() == true)
                        {
                            @foreach (var team in context.Teams)
                            {
                                <MudChip Variant="Variant.Outlined">@team.Name</MudChip>
                            }
                        }
                        else
                        {
                            <MudChip Variant="Variant.Outlined" Color="Color.Warning">@Localizer["NoTeamAssigned"]</MudChip>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="Status">
                    <div style="max-height: @Configuration["Settings:TableScrollAt"]; overflow-y:scroll">
                        @if (context?.Activated == true)
                        {
                            <MudChip Variant="Variant.Outlined" Color="Color.Success">@Localizer["Active"]</MudChip>
                        }
                        else
                        {
                            <MudChip Variant="Variant.Outlined" Color="Color.Warning">@Localizer["InviteSent"]</MudChip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudItem>
</MudGrid>

@code {
    [CascadingParameter] private Task<AuthenticationState> _authenticationStateTask { get; set; }

    private MudTable<User> _table = new();
    private HashSet<User> _selectedEmployees = new HashSet<User>();
    private string _searchString = string.Empty;
    
    private bool _isMobile;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _isMobile = await JsRuntime.InvokeAsync<bool>("isSmallScreen");
        StateHasChanged();

        await base.OnAfterRenderAsync(firstRender);
    }

    public async Task<TableData<User>> ServerReload(TableState state)
    {
        _selectedEmployees.Clear();
        var employees = await EmployeeManager.GetAllAsync();
        var totalCount = employees.Count();

        if (employees == Enumerable.Empty<User>())
            Snackbar.Add(Localizer["ErrorLoadingData"], Severity.Error);

        if (string.IsNullOrWhiteSpace(_searchString))
        {
            if (employees.Any())
            {
                switch (state.SortLabel)
                {
                    case "employeeFullName_field":
                        employees = employees.OrderByDirection(state.SortDirection, t => t.FullName);
                        break;
                    case "userEmail_field":
                        employees = employees.OrderByDirection(state.SortDirection, t => t.Email);
                        break;
                    case "userTeam_field":
                        employees = employees.OrderByDirection(state.SortDirection, t => (
                            t.Teams ?? new List<Team>()).FirstOrDefault()?.Name);
                        break;
                }
            }
        }

        if (string.IsNullOrWhiteSpace(_searchString) || !employees.Any())
        {
            return new TableData<User>() { TotalItems = totalCount, Items = employees };
        }

        employees = employees.Where(x =>
        {
            if (x.Id.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;
            if (x.FullName.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;
            if (x.Teams != null &&
                x.Teams.Any(team => team.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase)))
                return true;

            return false;
        });

        return new TableData<User>() { TotalItems = totalCount, Items = employees };
    }

    private async void OnSearch(string text)
    {
        _searchString = text;
        await _table.ReloadServerData();
    }

    private async Task EditEmployee(MouseEventArgs obj)
    {
        var parameters = new DialogParameters<EditEmployeeDialog> { { x => x.Employee, _selectedEmployees.First() } };
        var dialog = await DialogService.ShowAsync<EditEmployeeDialog>(@Localizer["ModifyEmployee"], parameters);
        await dialog.Result;
        await _table.ReloadServerData();
    }

    private async Task AddEmployee(MouseEventArgs arg)
    {
        var dialog = await DialogService.ShowAsync<AddEmployeeDialog>(@Localizer["InviteEmployee"]);
        var dialogResult = await dialog.Result;

        if (dialogResult.Canceled)
        {
            Snackbar.Add(Localizer["ErrorOccurred"], Severity.Error);
            return;
        }

        if (!Convert.ToBoolean(dialogResult.Data))
            return;

        Snackbar.Add(Localizer["SuccessfullyAddedEmployee"], Severity.Success);
        await _table.ReloadServerData();
    }

    private async Task DeleteEmployee()
    {
        var parameters = new DialogParameters<YesNoDialog>();
        parameters.Add(x => x.ContentText, @Localizer["DoYouWantToDeleteEmployees"]);
        var dialog = await DialogService.ShowAsync<YesNoDialog>(@Localizer["DeleteEmployees"], parameters);
        var dialogResult = await dialog.Result;

        if (dialogResult.Canceled) return;

        foreach (var employee in _selectedEmployees)
        {
            var deleted = await IdentityUserManager.DeleteAsync(employee);

            if (deleted.Succeeded) continue;

            Snackbar.Add(Localizer["ErrorOccurred", Severity.Error]);
            break;
        }

        Snackbar.Add(Localizer["SuccessfullyDeletedEntries"], Severity.Success);
        await _table.ReloadServerData();
    }

}