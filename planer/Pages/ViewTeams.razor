@page "/teams"
@attribute [Authorize]

@using CrossCutting.Language
@using Microsoft.Extensions.Localization
@using CrossCutting.Entities.NotMapped
@using planer.Dialogs
@using planer.Dialogs.Team
@using TeamManagement.Contract
@using UserManagement.Contract
@using CrossCutting.Entities

@inject IStringLocalizer<Language> Localizer;
@inject IConfiguration Configuration;
@inject ISnackbar Snackbar;
@inject IDialogService DialogService;
@inject ITeamManager teamManager;
@inject IJSRuntime JsRuntime;

<PageTitle>@Localizer["ViewTeams"]</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h6">@Localizer["Team"]</MudText>
        <MudStack Row="@(!_isMobile)" Justify="Justify.SpaceBetween" Style="width: 100%" Class="mb-4">
            <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder=@Localizer["SearchPlaceHolder"]
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium">
            </MudTextField>

            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Success"
                       Variant="Variant.Outlined" OnClick="@AddTeam">
                @Localizer["AddTeam"]
            </MudButton>
        </MudStack>

        @if (_selectedTeams.Any())
        {
        <MudStack Row="@(!_isMobile)" Style="width: 100%" Justify="@(_isMobile ? Justify.Center : Justify.FlexEnd)">
            @if (_selectedTeams.Count == 1)
            {
            <MudButton StartIcon="@Icons.Material.Filled.Edit" Color="Color.Warning"
                       Variant="Variant.Outlined" OnClick="@EditTeam">
                @Localizer["ModifyTeam"]
            </MudButton>
            }

            <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error"
                       Variant="Variant.Outlined" OnClick="@DeleteTeam">
                @Localizer["DeleteTeam"]
            </MudButton>
        </MudStack>
        }
        
        <MudTable @ref="_table" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" FixedHeader="true"
                  Height="@Configuration["Settings:TableHeight"]" MultiSelection="true" Class="mt-4"
                  GroupHeaderStyle="background-color:var(--mud-palette-background-grey)" @bind-SelectedItems="@_selectedTeams"
                  GroupFooterClass="mb-4" Elevation="3" ServerData="@(new Func<TableState, Task<TableData<Team>>>(ServerReload))">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortLabel="teamId_field" T="Team">@Localizer["Id"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortLabel="teamName_field" T="Team">@Localizer["Name"]</MudTableSortLabel>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id">@context.Id</MudTd>
                <MudTd DataLabel="Content">
                    <div style="max-height: @Configuration["Settings:TableScrollAt"]; overflow-y:scroll">
                        @context.Name
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudItem>
</MudGrid>

@code {
    [CascadingParameter] private Task<AuthenticationState> _authenticationStateTask { get; set; }

    private MudTable<Team> _table = new();
    private HashSet<Team> _selectedTeams = new HashSet<Team>();
    private string _searchString = string.Empty;
    private bool _isMobile;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _isMobile = await JsRuntime.InvokeAsync<bool>("isSmallScreen");
        StateHasChanged();

        await base.OnAfterRenderAsync(firstRender);
    }

    public async Task<TableData<Team>> ServerReload(TableState state)
    {
        _selectedTeams.Clear();
        var teams = await teamManager.GetAllAsync();

        var totalCount = teams.Count();

        if (teams == Enumerable.Empty<Team>())
            Snackbar.Add(Localizer["ErrorLoadingData"], Severity.Error);

        if (string.IsNullOrWhiteSpace(_searchString))
        {
            if (teams.Any())
            {
                switch (state.SortLabel)
                {
                    case "teamId_field":
                        teams = teams.OrderByDirection(state.SortDirection, t => t.Id);
                        break;
                    case "teamName_field":
                        teams = teams.OrderByDirection(state.SortDirection, t => t.Name);
                        break;
                }
            }
        }

        if (string.IsNullOrWhiteSpace(_searchString) || !teams.Any())
        {
            return new TableData<Team>() { TotalItems = totalCount, Items = teams };
        }

        teams = teams.Where(x =>
        {
            if (x.Id.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;
            if (x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                return true;
            return false;
        });

        return new TableData<Team>() { TotalItems = totalCount, Items = teams };
    }

    private async void OnSearch(string text)
    {
        _searchString = text;
        await _table.ReloadServerData();
    }

    private async Task EditTeam(MouseEventArgs obj)
    {
        var parameters = new DialogParameters<AddEditTeamDialog>();
        parameters.Add(x => x.EditMode, true);
        parameters.Add(x => x.TeamToEdit, _selectedTeams.First());
        var dialog = await DialogService.ShowAsync<AddEditTeamDialog>(@Localizer["ModifyTeam"], parameters);
        var dialogResult = await dialog.Result;

        if (dialogResult.Canceled) return;

        var added = await teamManager.EditAsync(dialogResult.Data as Team ?? throw new Exception("No team available"));

        if (!added)
            Snackbar.Add(Localizer["ErrorOccurred"], Severity.Error);

        Snackbar.Add(Localizer["SuccessfullyModifiedTeam"], Severity.Success);
        await _table.ReloadServerData();
    }

    private async Task AddTeam(MouseEventArgs arg)
    {
        var parameters = new DialogParameters<AddEditTeamDialog>();
        parameters.Add(x => x.EditMode, false);

        var dialog = await DialogService.ShowAsync<AddEditTeamDialog>(@Localizer["AddTeam"], parameters);
        var dialogResult = await dialog.Result;

        if (dialogResult.Canceled) return;

        var added = await teamManager.AddAsync(dialogResult.Data as Team ?? throw new Exception("No team available"));

        if (!added)
            Snackbar.Add(Localizer["ErrorOccurred"], Severity.Error);

        Snackbar.Add(Localizer["SuccessfullyAddedTeam"], Severity.Success);
        await _table.ReloadServerData();
    }

    private async Task DeleteTeam()
    {
        var parameters = new DialogParameters<YesNoDialog>();
        parameters.Add(x => x.ContentText, @Localizer["DoYouWantToDeleteTeams"]);
        var dialog = await DialogService.ShowAsync<YesNoDialog>(@Localizer["DeleteTeams"], parameters);
        var dialogResult = await dialog.Result;

        if (dialogResult.Canceled) return;

        foreach (var team in _selectedTeams)
        {
            var deleted = await teamManager.DeleteAsync(team);

            if (deleted) continue;

            Snackbar.Add(Localizer["ErrorOccurred", Severity.Error]);
            break;
        }

        Snackbar.Add(Localizer["SuccessfullyDeletedEntries"], Severity.Success);
        await _table.ReloadServerData();
    }

}